<?xml version="1.0" encoding="utf-8" ?>

<cdsl>
    <!-- If with nested elements: run body only when context var matches -->
    <flow id="ifWithNestedFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="choice" val="yes"/>
            <if condition="choice=yes">
                <setVar name="whenYes" val="executed"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>

        <step id="end">
            <endRoute/>
            <finally>
                <setState val="End"/>
            </finally>
        </step>

        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: literal true -->
    <flow id="ifConditionTrueFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <if condition="true">
                <setVar name="whenTrue" val="executed"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: literal false -->
    <flow id="ifConditionFalseFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <if condition="false">
                <setVar name="whenTrue" val="shouldNotRun"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: varName (exists and non-empty) -->
    <flow id="ifConditionVarExistsFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="flag" val="set"/>
            <if condition="flag">
                <setVar name="whenFlagSet" val="executed"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: varName=value -->
    <flow id="ifConditionEqualsFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="role" val="admin"/>
            <if condition="role=admin">
                <setVar name="whenAdmin" val="executed"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: varName!=value -->
    <flow id="ifConditionNotEqualsFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="role" val="user"/>
            <if condition="role!=admin">
                <setVar name="whenNotAdmin" val="executed"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: varName == value (double-equals, no quotes) -->
    <flow id="ifConditionDoubleEqualsFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="role" val="admin"/>
            <if condition="role == admin">
                <setVar name="whenAdmin" val="executed"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: varName == 'value' (double-equals with single-quoted value) -->
    <flow id="ifConditionDoubleEqualsQuotedFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="regime" val="CRISIS"/>
            <if condition="regime == 'CRISIS'">
                <setVar name="whenCrisis" val="executed"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: varName == 'value' does NOT match when values differ -->
    <flow id="ifConditionDoubleEqualsNoMatchFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="regime" val="NORMAL"/>
            <if condition="regime == 'CRISIS'">
                <setVar name="shouldNotRun" val="executed"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: OR — first branch matches -->
    <flow id="ifConditionOrFirstMatchFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="regime" val="CRISIS"/>
            <if condition="regime == 'CRISIS' || regime == 'EXTREME'">
                <setVar name="buyBlocked" val="true"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: OR — second branch matches -->
    <flow id="ifConditionOrSecondMatchFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="regime" val="EXTREME"/>
            <if condition="regime == 'CRISIS' || regime == 'EXTREME'">
                <setVar name="buyBlocked" val="true"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: OR — neither branch matches -->
    <flow id="ifConditionOrNoMatchFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="regime" val="NORMAL"/>
            <if condition="regime == 'CRISIS' || regime == 'EXTREME'">
                <setVar name="buyBlocked" val="true"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: AND — both conjuncts true -->
    <flow id="ifConditionAndBothMatchFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="ptAction" val="SELL"/>
            <setVar name="dipVeto" val="false"/>
            <if condition="ptAction == 'SELL' &amp;&amp; dipVeto != 'true'">
                <setVar name="sellAllowed" val="true"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: AND keyword — XML-friendly alternative to &amp;&amp; -->
    <flow id="ifConditionAndKeywordFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="ptAction" val="SELL"/>
            <setVar name="dipVeto" val="false"/>
            <if condition="ptAction == 'SELL' AND dipVeto != 'true'">
                <setVar name="sellAllowedKeyword" val="true"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: NOT keyword (unary) -->
    <flow id="ifConditionNotKeywordFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="flag" val="set"/>
            <if condition="NOT flag">
                <setVar name="shouldNotRun" val="true"/>
                <routeTo target="end"/>
            </if>
            <if condition="NOT missingFlag">
                <setVar name="notMissingFlagRan" val="true"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: XOR keyword -->
    <flow id="ifConditionXorKeywordFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="a" val="true"/>
            <setVar name="b" val="false"/>
            <if condition="a == 'true' XOR b == 'true'">
                <setVar name="xorOk" val="true"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: parentheses override precedence -->
    <flow id="ifConditionParenthesesOverrideFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="a" val="true"/>
            <setVar name="b" val="false"/>
            <setVar name="c" val="false"/>

            <!-- Without parentheses: a || (b && c) => true || (false && false) => true -->
            <if condition="a == 'true' || b == 'true' AND c == 'true'">
                <setVar name="noParensResult" val="true"/>
            </if>

            <!-- With parentheses: (a || b) && c => (true || false) && false => false -->
            <if condition="(a == 'true' || b == 'true') AND c == 'true'">
                <setVar name="parensResult" val="true"/>
            </if>

            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: AND — second conjunct false -->
    <flow id="ifConditionAndSecondFailsFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="ptAction" val="SELL"/>
            <setVar name="dipVeto" val="true"/>
            <if condition="ptAction == 'SELL' &amp;&amp; dipVeto != 'true'">
                <setVar name="sellAllowed" val="true"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: && vs || precedence — a || b && c => a || (b && c) -->
    <flow id="ifConditionOrAndPrecedenceFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="a" val="true"/>
            <setVar name="b" val="false"/>
            <setVar name="c" val="false"/>
            <if condition="a == 'true' || b == 'true' &amp;&amp; c == 'true'">
                <setVar name="precedenceOk" val="yes"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: existing single = with single-quoted value (backwards-compat) -->
    <flow id="ifConditionSingleEqualsQuotedFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="status" val="active"/>
            <if condition="status = 'active'">
                <setVar name="whenActive" val="executed"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: isNotEmpty(varName) — var is set -->
    <flow id="ifIsNotEmptySetFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="decisions" val="VIM-USDT,GUA-USDT"/>
            <if condition="isNotEmpty(decisions)">
                <setVar name="isNotEmptyResult" val="true"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: isNotEmpty(varName) — var is not set -->
    <flow id="ifIsNotEmptyUnsetFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <if condition="isNotEmpty(missingVar)">
                <setVar name="shouldNotRun" val="true"/>
                <routeTo target="end"/>
            </if>
            <setVar name="isNotEmptyUnsetResult" val="skipped"/>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- Condition expression: NOT isNotEmpty(varName) — var is not set, so NOT isNotEmpty = true -->
    <flow id="ifNotIsNotEmptyUnsetFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <if condition="NOT isNotEmpty(missingVar)">
                <setVar name="notIsNotEmptyResult" val="true"/>
                <routeTo target="end"/>
            </if>
            <routeTo target="end"/>
        </step>
        <step id="end">
            <endRoute/>
            <finally><setState val="End"/></finally>
        </step>
        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- ForEach: run nested elements once per item in a context list var (comma-separated) -->
    <flow id="foreachFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="items" val="apple,banana,cherry"/>
            <setVar name="lastItem" val=""/>
            <foreach listVar="items" itemVar="it">
                <setVar name="lastItem" val="it"/>
            </foreach>
            <routeTo target="end"/>
        </step>

        <step id="end">
            <endRoute/>
            <finally>
                <setState val="End"/>
            </finally>
        </step>

        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>

    <!-- ForEach multi-iteration: verifies body runs once per item, not just the first -->
    <flow id="foreachAllIterationsFlow" defaultStep="init" errorStep="error">
        <step id="init">
            <setState val="Alive"/>
            <setVar name="symbols" val="A,B,C"/>
            <foreach listVar="symbols" itemVar="sym">
                <injected name="foreachBodyCounter"/>
            </foreach>
            <routeTo target="end"/>
        </step>

        <step id="end">
            <endRoute/>
            <finally>
                <setState val="End"/>
            </finally>
        </step>

        <step id="error">
            <setState val="Error"/>
            <endRoute/>
        </step>
    </flow>
</cdsl>
